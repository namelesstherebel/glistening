# Writes OUT: one `{"path", R"__TV__(text)__TV__"},` initializer per shader
# under ROOT (scenes/common.glsl first, like the Makefile), so the binary runs
# from any directory. Run as `cmake -DROOT=... -DOUT=... -P embed-shaders.cmake`.
# Each text is emitted as adjacent raw-string pieces of at most ~8 KB split at
# line ends: MSVC rejects single string literals over 16 KB.
file(GLOB scenes RELATIVE "${ROOT}" "${ROOT}/scenes/*.frag" "${ROOT}/scenes/*.vert")
file(GLOB shaders RELATIVE "${ROOT}" "${ROOT}/shaders/*")
list(SORT scenes)
list(SORT shaders)
set(out "")
foreach(f scenes/common.glsl ${scenes} ${shaders})
  file(READ "${ROOT}/${f}" text)
  if(text MATCHES "\\)__TV__\"")
    message(FATAL_ERROR "${f} contains the raw-string delimiter )__TV__\"")
  endif()
  string(APPEND out "{\"${f}\", ")
  while(NOT text STREQUAL "")
    string(LENGTH "${text}" n)
    if(n GREATER 8000)
      string(SUBSTRING "${text}" 0 8000 piece)
      string(FIND "${piece}" "\n" cut REVERSE)
      if(cut LESS 0)
        set(cut 7999)
      endif()
      math(EXPR cut "${cut} + 1")
      string(SUBSTRING "${text}" 0 ${cut} piece)
      string(SUBSTRING "${text}" ${cut} -1 text)
    else()
      set(piece "${text}")
      set(text "")
    endif()
    string(APPEND out "R\"__TV__(${piece})__TV__\" ")
  endwhile()
  string(APPEND out "\"\"},\n")
endforeach()
file(WRITE "${OUT}.tmp" "${out}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
